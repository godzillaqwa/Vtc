PORT=3000
# Braiins Pool API token. Never commit the real token.
BRAIINS_POOL_TOKEN=
BRAIINS_COIN=btc

# Optional payout address for direct on-chain balance/transaction visibility.
BITCOIN_PAYOUT_ADDRESS=

# Optional: identify the operating entity/site in the dashboard.
COMPANY_NAME=Frosted Mining Company
SITE_NAME=Primary Mining Site

# Safety: read-only integrations by default. No remote miner control is exposed by this app.
READ_ONLY=true
